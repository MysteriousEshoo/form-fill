# Supabase project URL (Settings → API → Project URL)
VITE_SUPABASE_URL=

# Supabase anon public key (Settings → API → anon public)
VITE_SUPABASE_ANON_KEY=

# Public HTTPS URL of the deployed app (e.g. https://formflow.vercel.app).
# Iske baghair link localhost par banega aur WhatsApp par share nahi hoga.
VITE_APP_URL=
